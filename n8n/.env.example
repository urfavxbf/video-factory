# Copy to n8n/.env (which is ignored by Git). Never commit real credentials.
# Review the current stable n8n image before upgrading.
N8N_VERSION=2.44.6
POSTGRES_USER=n8n
POSTGRES_DB=n8n
# Generate separate strong random values, e.g. python3 -c 'import secrets; print(secrets.token_hex(32))'
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_POSTGRES_PASSWORD
N8N_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_64_CHARACTER_HEX_KEY
